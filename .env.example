# Optional live model for the flagship booth (Talk, Map, Calls).
# Leave AI_API_KEY empty and every game uses the offline stub.
# The key is read only by the server route api/ai.js. It must not
# be pasted into a page, a script, or this example.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
