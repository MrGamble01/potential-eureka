# Optional live model for the flagship booth (Talk, Map, Calls).
# Leave AI_API_KEY empty and createAiProvider stays on the offline stub.
# api/ai.js reads these. The key must not be pasted into a page, a
# script, or this example. The games in the browser use the stub.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
