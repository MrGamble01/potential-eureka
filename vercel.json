{
    "outputDirectory": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        { "source": "/startup-tycoon.html", "destination": "/tycoon", "permanent": true },
        { "source": "/startup-tycoon", "destination": "/tycoon", "permanent": true },
        { "source": "/tycoon/beagle", "destination": "/tycoon/play?theme=beagle", "permanent": true },
        { "source": "/tycoon/beagle.html", "destination": "/tycoon/play?theme=beagle", "permanent": true },
        { "source": "/grow-op", "destination": "/drug-lab", "permanent": true },
        { "source": "/growop", "destination": "/drug-lab", "permanent": true },
        { "source": "/voxel-isle", "destination": "/voxel-garden", "permanent": true },
        { "source": "/voxelisle", "destination": "/voxel-garden", "permanent": true },
        { "source": "/studio", "destination": "/agentic-os", "permanent": true },
        { "source": "/eureka-studio", "destination": "/agentic-os", "permanent": true },
        { "source": "/snake", "destination": "/#snake", "permanent": false },
        { "source": "/tetris", "destination": "/#tetris", "permanent": false },
        { "source": "/2048", "destination": "/#2048", "permanent": false },
        { "source": "/game2048", "destination": "/#2048", "permanent": false },
        { "source": "/breakout", "destination": "/#breakout", "permanent": false },
        { "source": "/neon-breaker", "destination": "/#breakout", "permanent": false },
        { "source": "/asteroids", "destination": "/#asteroids", "permanent": false },
        { "source": "/vector-storm", "destination": "/#asteroids", "permanent": false },
        { "source": "/minesweeper", "destination": "/#minesweeper", "permanent": false },
        { "source": "/minefield", "destination": "/#minesweeper", "permanent": false },
        { "source": "/connect4", "destination": "/#connect4", "permanent": false },
        { "source": "/drop-four", "destination": "/#connect4", "permanent": false },
        { "source": "/word5", "destination": "/#word5", "permanent": false },
        { "source": "/word-five", "destination": "/#word5", "permanent": false },
        { "source": "/lightcycles", "destination": "/#lightcycles", "permanent": false },
        { "source": "/light-cycles", "destination": "/#lightcycles", "permanent": false },
        { "source": "/pong", "destination": "/#pong", "permanent": false },
        { "source": "/stacker", "destination": "/#stacker", "permanent": false },
        { "source": "/crateescape", "destination": "/#crateescape", "permanent": false },
        { "source": "/crate-escape", "destination": "/#crateescape", "permanent": false },
        { "source": "/vectordefense", "destination": "/#vectordefense", "permanent": false },
        { "source": "/vector-defense", "destination": "/#vectordefense", "permanent": false },
        { "source": "/wordcascade", "destination": "/#wordcascade", "permanent": false },
        { "source": "/word-cascade", "destination": "/#wordcascade", "permanent": false },
        { "source": "/memorymatrix", "destination": "/#memorymatrix", "permanent": false },
        { "source": "/memory-matrix", "destination": "/#memorymatrix", "permanent": false },
        { "source": "/maze", "destination": "/#maze", "permanent": false },
        { "source": "/maze-runner", "destination": "/#maze", "permanent": false },
        { "source": "/life", "destination": "/#life", "permanent": false },
        { "source": "/game-of-life", "destination": "/#life", "permanent": false },
        { "source": "/halloffame", "destination": "/#halloffame", "permanent": false },
        { "source": "/hall-of-fame", "destination": "/#halloffame", "permanent": false }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
            ]
        },
        {
            "source": "/vendor/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/css/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/js/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        }
    ]
}
